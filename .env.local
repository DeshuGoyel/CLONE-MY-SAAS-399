# ===========================
# CORE CONFIGURATION
# ===========================

# Application Environment (DEVELOPMENT or PRODUCTION)
ENVIRONMENT=DEVELOPMENT
NODE_ENV=development

# ===========================
# SUPABASE CONFIGURATION
# ===========================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================
# PAYMENT PROCESSING (STRIPE)
# ===========================
# When ENVIRONMENT=DEVELOPMENT, uses STRIPE_TEST_SECRET_KEY
# When ENVIRONMENT=PRODUCTION, uses STRIPE_SECRET_KEY
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_SECRET_KEY=sk_live_...

# ===========================
# EMAIL SERVICE (SENDGRID)
# ===========================
SENDGRID_API_KEY=SG.your-api-key
NOREPLY_EMAIL=noreply@cvphoto.app

# ===========================
# AI MODEL API (ASTRIA)
# ===========================
ASTRIA_API_KEY=your-astria-api-key

# ===========================
# WEBHOOK SECURITY
# ===========================
# Secret key for validating webhook requests
APP_WEBHOOK_SECRET=your-secure-webhook-secret

# ===========================
# MONITORING & ERROR TRACKING
# ===========================
# Sentry DSN for error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ===========================
# STORAGE (OPTIONAL)
# ===========================
# Direct S3 access (optional - Supabase handles this by default)
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=

# ===========================
# RATE LIMITING & CACHING
# ===========================
# Redis URL for production caching (optional - uses in-memory cache by default)
# REDIS_URL=

# ===========================
# SECURITY CONFIGURATION
# ===========================
# CORS allowed origins (comma-separated)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===========================
# PERFORMANCE MONITORING
# ===========================
# Enable performance tracking
# ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=dummy_service_role_key
STRIPE_TEST_SECRET_KEY=sk_test_dummy
STRIPE_SECRET_KEY=sk_live_dummy
SENDGRID_API_KEY=SG.dummy
ASTRIA_API_KEY=dummy_astria_key
APP_WEBHOOK_SECRET=dummy_webhook_secret
